{
  "name": "acevoice",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "main": "dist-shell/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build --base=./ && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:tesseract.js --outdir=dist-shell --out-extension:.js=.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "prebuild": "node scripts/icon.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "resedit": "3.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "author": "Koro LTCM",
  "productName": "AceVoice",
  "description": "AceVoice local dialogue companion by Koro LTCM"
}
